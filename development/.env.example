# ==============================================================================
# development/.env — Local config synced to GitHub via `gh` by scripts/setup.sh
# Copy to `development/.env` (chmod 600) and fill in your values.
# ==============================================================================

# --- GitHub Repository & Runner Selection -------------------------------------
GITHUB_REPO=vitorecomp/personal-infra
GITHUB_ENV=gpu
# Optional token for `gh` CLI (leave empty when `gh auth login` is already active)
GH_TOKEN=

# Repository variable controlling `runs-on:` in .github/workflows/deploy-gpu-machine.yml
# (`gcp-gpu`, `azure-gpu`, or `on-prem-gpu` — defaults to `<provider>-gpu`)
GPU_RUNNER=gcp-gpu
# Optional full JSON array override for `runs-on:` (leave empty to use GPU_RUNNER)
GPU_RUNNER_LABELS=

# Optional explicit runner token or PAT (leave empty to auto-mint via `gh api`)
RUNNER_TOKEN=
RUNNER_PAT=

# --- Core Stack Secrets (`gpu` GitHub Environment) ----------------------------
# Leave as `__generate__` so setup.sh generates a strong `sk-...` key once, saves it
# in `development/.env`, and uploads it to GitHub Secrets (or paste your own `sk-...` key).
LITELLM_MASTER_KEY=__generate__

# Optional Hugging Face read token (avoids rate limits pulling DeepSeek-V4.1-Flash)
HF_TOKEN=

# --- Reverse SSH Tunnels (`gpu` GitHub Environment) ---------------------------
# Set ENABLE_REVERSE_TUNNELS=true and fill in host/user/key file to run
# `litellm-tunnel` and `deepseek-harness-tunnel`; keep false to skip tunnels.
ENABLE_REVERSE_TUNNELS=false
TUNNEL_SSH_HOST=
TUNNEL_SSH_PORT=22
TUNNEL_SSH_USER=
# Local workstation file path to the private key uploaded as GitHub Secret TUNNEL_SSH_PRIVATE_KEY
TUNNEL_SSH_KEY_FILE=
# Optional pinned known_hosts string (or local file path) for TUNNEL_SSH_HOST
TUNNEL_KNOWN_HOSTS=
TUNNEL_BIND_ADDRESS=127.0.0.1
REMOTE_LITELLM_PORT=4000
REMOTE_HARNESS_PORT=3080

# Optional per-tunnel destination overrides (leave empty to inherit TUNNEL_SSH_*)
LITELLM_TUNNEL_SSH_HOST=
LITELLM_TUNNEL_SSH_PORT=
LITELLM_TUNNEL_SSH_USER=
HARNESS_TUNNEL_SSH_HOST=
HARNESS_TUNNEL_SSH_PORT=
HARNESS_TUNNEL_SSH_USER=

# --- Optional Non-GCP Runner-to-GPU Routing -----------------------------------
# `auto` (default: uses `gpu-ssh` on GCP controller), `controller-ssh`, `ssh`, or `local`
GPU_TARGET_MODE=auto
GPU_SSH_HOST=
GPU_SSH_KEY_FILE=
GPU_SSH_KNOWN_HOSTS=

# Set `true` (or pass --trigger-deploy) to run `gh workflow run deploy-gpu-machine.yml` at the end
TRIGGER_DEPLOY=false
