# ==============================================================================
# development/.env — GPU Machine & Runner Configuration
# ==============================================================================
# Security & Usage:
#   - Gitignored and restricted to owner-only permissions (`chmod 600 development/.env`).
#   - Any `__generate__` value (`LITELLM_MASTER_KEY`, `TUNNEL_SSH_KEY_FILE`) is
#     generated once and written back into this file automatically by:
#       ./development/scripts/setup.sh --provider=gcp --dry-run
#       ./development/scripts/setup.sh --provider=gcp
#   - On GCP, provisioning is 100% SSH-free: `deploy.sh --provider=gcp` reads the
#     MIG/network/runner settings below, stores runner bootstrap config in GCP
#     Secret Manager, and creates a single-VM Stateful Zonal Managed Instance
#     Group (`<name_prefix>-mig`) that self-registers its GitHub Actions runner
#     on boot and auto-resumes the Podman stack across Spot recreations.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. GitHub Repository & Self-Hosted Runner Pool
# ------------------------------------------------------------------------------

# Target GitHub repository (`owner/repo`) where variables, secrets, and the runner are registered.
GITHUB_REPO=vitorecomp/personal-infra

# Protected GitHub Environment holding GPU stack secrets and tunnel settings.
GITHUB_ENV=gpu

# Optional token for `gh` CLI (leave empty when `gh auth login` is already active).
GH_TOKEN=

# Repository Variable controlling `runs-on:` in `.github/workflows/deploy-gpu-machine.yml`
# (`gcp-gpu`, `azure-gpu`, or `on-prem-gpu` — defaults to `<provider>-gpu`).
GPU_RUNNER=gcp-gpu

# Full JSON label array synced to Repository Variable `GPU_RUNNER_LABELS` for `runs-on:`.
GPU_RUNNER_LABELS=["self-hosted","linux","x64","gcp-gpu"]

# Runner name and comma-separated labels registered by the GPU machine on boot.
RUNNER_NAME=gcp-gpu-runner
RUNNER_LABELS=self-hosted,linux,x64,gcp-gpu

# Optional repo-scoped Fine-Grained PAT with Administration (Read & Write) permission.
# When empty, `deploy.sh` auto-mints a 1-hour registration token via `gh api` for initial
# registration, and the stateful `/mnt/data/actions-runner` disk persists `.credentials`
# across Spot VM recreations.
RUNNER_PAT=


# ------------------------------------------------------------------------------
# 2. GCP MIG & Networking Configuration (`deploy.sh`)
# ------------------------------------------------------------------------------

# Optional GCP project override (defaults to active `gcloud config get-value project`).
PROJECT_ID=

# Optional default GCP region and zone (defaults to `europe-west4` / `europe-west4-a`,
# or candidate GPU zones when cycling).
REGION=
ZONE=

# GPU VM provisioning model (`true` = Spot GPU VM auto-healed by MIG; `false` = Standard on-demand GPU VM).
USE_SPOT=true

# Set `true` to attach the MIG instance to the existing `default` VPC instead of creating `dev-gpu-vpc`.
USE_DEFAULT_VPC=false
DEFAULT_VPC_NAME=default

# Manage VPC ingress firewall rules in Terraform (`true` by default; set `false` if external org policies manage VPC ingress).
ENABLE_INGRESS_FIREWALLS=true

# Proxy CIDR ranges allowed on TCP port 22 for optional admin debugging (defaults to Google Cloud IAP `35.235.240.0/20`).
SSH_PROXY_CIDRS=35.235.240.0/20


# ------------------------------------------------------------------------------
# 3. Core GPU Stack Secrets (Synced to `gpu` GitHub Environment Secrets by `setup.sh`)
# ------------------------------------------------------------------------------

# Master Bearer key securing the `litellm` proxy (:4000) and injected into `deepseek-harness`.
# Leave as `__generate__` so `setup.sh` generates a random `sk-...` key once, saves it here,
# and uploads it to GitHub Secrets (or set your own `sk-...` key).
LITELLM_MASTER_KEY=__generate__

# Optional Hugging Face read token to avoid rate limits pulling `deepseek-ai/DeepSeek-V4.1-Flash`.
HF_TOKEN=


# ------------------------------------------------------------------------------
# 4. Reverse SSH Tunnels (Synced to `gpu` GitHub Environment by `setup.sh`)
# ------------------------------------------------------------------------------

# Set `true` to start `litellm-tunnel` and `deepseek-harness-tunnel`, or `false` to skip tunnels.
ENABLE_REVERSE_TUNNELS=false

# Remote host receiving the reverse-forwarded ports. The standard target is the GCE VM `personal-host`
# (cloud/infra/envs/gcp-taiga, `terraform output public_ip`), where LiteLLM / the harness are then usable on
# 127.0.0.1 only (nothing is exposed to the internet). Synced as a `gpu` environment SECRET (masked in public
# logs), as is TUNNEL_KNOWN_HOSTS.
TUNNEL_SSH_HOST=

# SSH port and username on `TUNNEL_SSH_HOST` (`tunnel` on personal-host: a no-shell user created by
# `cloud/scripts/bootstrap_vm.py --tunnel-pubkey-file ~/.ssh/gpu_tunnel_ed25519.pub`).
TUNNEL_SSH_PORT=22
TUNNEL_SSH_USER=

# Local workstation private key uploaded as GitHub Secret `TUNNEL_SSH_PRIVATE_KEY`.
# Leave as `__generate__` so `setup.sh` creates `~/.ssh/gpu_tunnel_ed25519` (+ `.pub`) once
# and saves its path here.
TUNNEL_SSH_KEY_FILE=__generate__

# Optional pinned `ssh-keyscan` line(s) OR local known_hosts file path for `TUNNEL_SSH_HOST`.
TUNNEL_KNOWN_HOSTS=

# Interface bound on `TUNNEL_SSH_HOST` (`127.0.0.1` for local-only, or `0.0.0.0` with GatewayPorts).
# personal-host: keep `127.0.0.1` — its tunnel key may only open 127.0.0.1:4000 and 127.0.0.1:3080.
TUNNEL_BIND_ADDRESS=127.0.0.1

# Remote ports opened on `TUNNEL_SSH_HOST` forwarding to `litellm:4000` and `deepseek-harness:3080`.
REMOTE_LITELLM_PORT=4000
REMOTE_HARNESS_PORT=3080

# Optional per-tunnel destination overrides (leave empty to inherit `TUNNEL_SSH_*` above).
LITELLM_TUNNEL_SSH_HOST=
LITELLM_TUNNEL_SSH_PORT=
LITELLM_TUNNEL_SSH_USER=
HARNESS_TUNNEL_SSH_HOST=
HARNESS_TUNNEL_SSH_PORT=
HARNESS_TUNNEL_SSH_USER=


# ------------------------------------------------------------------------------
# 5. Runner-to-GPU Target Routing & Post-Setup Trigger
# ------------------------------------------------------------------------------

# How `deploy_gpu_stack.sh` reaches the GPU host:
#   `local` (default: runner executes directly on the GPU machine),
#   `auto` (detects `GPU_SSH_HOST` if set, else `local`), or `ssh`.
GPU_TARGET_MODE=local

# Optional SSH target, local private key file, and `known_hosts` when `GPU_TARGET_MODE=ssh`.
GPU_SSH_HOST=
GPU_SSH_KEY_FILE=
GPU_SSH_KNOWN_HOSTS=

# Set `true` (or pass `--trigger-deploy`) to dispatch `deploy-gpu-machine.yml` right after `setup.sh`.
TRIGGER_DEPLOY=false
