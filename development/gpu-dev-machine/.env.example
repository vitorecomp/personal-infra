# Copy to .env (chmod 600 .env) on the GPU VM before running podman-compose.
# Note: All model & vLLM parameters are controlled directly in `compose.yml` (vllm-server command).

# --- Shared Authentication (LiteLLM <-> DeepSeek Harness) --------------------
LITELLM_MASTER_KEY=changeme-litellm-master-key

# Optional Hugging Face token (DeepSeek-V4.1-Flash is ungated, but HF_TOKEN avoids rate limits)
HF_TOKEN=

# --- Persistent Storage Paths on the 3 TB Hyperdisk (/mnt/data) --------------
HF_CACHE_DIR=/mnt/data/huggingface
HARNESS_DATA_DIR=/mnt/data/deepseek-harness/dsh-home
HARNESS_WORKSPACE_DIR=/mnt/data/deepseek-harness/workspace
TUNNEL_STATE_DIR=/mnt/data/reverse-tunnel/state

# --- Reverse SSH Tunnels (litellm-tunnel & deepseek-harness-tunnel) ----------
# Target machine receiving the reverse-forwarded ports (e.g. controller VM 10.10.0.10 or external bastion)
TUNNEL_SSH_HOST=10.10.0.10
TUNNEL_SSH_PORT=22
TUNNEL_SSH_USER=dev
TUNNEL_SSH_KEY_FILE=/mnt/data/reverse-tunnel/id_ed25519
# Per-tunnel destinations actually read by compose.yml. podman-compose 1.0.x cannot resolve nested
# ${A:-${B}} defaults, so deploy_gpu_stack.sh writes these resolved (falling back to TUNNEL_SSH_*);
# for a manual run set them explicitly.
LITELLM_TUNNEL_SSH_HOST=10.10.0.10
LITELLM_TUNNEL_SSH_PORT=22
LITELLM_TUNNEL_SSH_USER=dev
HARNESS_TUNNEL_SSH_HOST=10.10.0.10
HARNESS_TUNNEL_SSH_PORT=22
HARNESS_TUNNEL_SSH_USER=dev

# Optional pinned known_hosts file on host (leave pointing to an empty file to use accept-new TOFU in TUNNEL_STATE_DIR)
TUNNEL_KNOWN_HOSTS_FILE=/mnt/data/reverse-tunnel/known_hosts
# Interface bound on the remote machine (`127.0.0.1` works with default sshd; `0.0.0.0` requires GatewayPorts clientspecified)
TUNNEL_BIND_ADDRESS=127.0.0.1
REMOTE_LITELLM_PORT=4000
REMOTE_HARNESS_PORT=3080

# log-shipper (started with the tunnels): streams the VM journal to LOG_SSH_USER@LOG_SSH_HOST, which appends it to
# /var/log/gpu-dev/<LOG_STREAM>.log (deploy_gpu_stack.sh defaults the host/port to TUNNEL_SSH_HOST/PORT)
LOG_SSH_HOST=bastion.example.com
LOG_SSH_PORT=22
LOG_SSH_USER=gpulog
LOG_STREAM=gpu-vm
