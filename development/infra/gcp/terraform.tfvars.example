# Optional: deploy.sh automatically uses your logged-in gcloud credentials and active project.
# Copy to terraform.tfvars only if you want persistent overrides.
# project_id = "your-gcp-project-id"
region      = "europe-west4"
zone        = "europe-west4-a"
name_prefix = "dev-gpu"

controller_machine_type = "e2-small"
controller_disk_size_gb = 100
machine_type            = "g4-standard-192"
provisioning_model      = "SPOT"

# Public internet ingress is disabled by default; SSH connects via `gcloud compute ssh --tunnel-through-iap`.
# enable_public_ingress = false

# Disable if external policy controllers manage VPC ingress rules:
# enable_ingress_firewalls = false

# Cloud OS Login defaults to true, and OS Login SSH key import in Terraform is disabled by default
# (`register_oslogin_ssh_key = false`) because `gcloud compute ssh` manages its own OS Login key natively.
# register_oslogin_ssh_key = false
# enable_os_login = false
