# Optional: deploy.sh automatically uses your logged-in gcloud credentials and active project.
# Copy to terraform.tfvars only if you want persistent overrides.
# project_id = "your-gcp-project-id"
region      = "europe-west4"
zone        = "europe-west4-a"
name_prefix = "dev-gpu"

# Provisioning model:
#   use_spot = true   -> Spot GPU VM auto-healed/recreated by the Stateful MIG
#   use_spot = false  -> Standard on-demand GPU VM
machine_type = "g4-standard-192"
use_spot     = true

# Networking:
#   use_default_vpc = false -> creates a dedicated custom VPC + subnet
#   use_default_vpc = true  -> attaches to the existing 'default' VPC network
use_default_vpc = false
# default_vpc_name = "default"

# Attach an ephemeral external IP on nic0 (true) or route outbound traffic via Cloud Router + Cloud NAT (false):
# enable_external_ip = true

# Optional admin SSH debugging ingress (normal workflow is zero-SSH via GitHub Actions outbound HTTPS):
# enable_public_ingress    = false
# ssh_proxy_cidrs          = ["35.235.240.0/20"]
# enable_ingress_firewalls = true
# enable_os_login          = true

# Self-registering GitHub Actions runner settings (stored in Secret Manager).
# Pass runner_token / runner_pat via TF_VAR_runner_token / TF_VAR_runner_pat (managed by deploy.sh);
# never commit tokens or PATs to terraform.tfvars.
# github_repo     = "owner/repo"
# runner_name     = "gcp-gpu-runner"
# runner_labels   = "self-hosted,linux,x64,gcp-gpu"
# runner_username = "github-runner"
