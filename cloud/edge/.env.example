# Template for /opt/stacks/edge/.env on the VM (created by deploy_stack.py --init-env).
ACME_EMAIL=admin@example.com
# Per-site TLS: the ACME email (Let's Encrypt) once DNS points at this VM, "internal" before that.
TAIGA_TLS=admin@example.com
BLOG_TLS=internal
# Taiga's Cloud Run URL (terraform output taiga_run_url in cloud/infra/envs/gcp-taiga)
TAIGA_UPSTREAM=https://taiga-000000000000.us-central1.run.app
