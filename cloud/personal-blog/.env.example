# Template for /opt/stacks/personal-blog/.env (mode 0600 on the VM, never committed,
# never written by CI). `deploy_stack.py --init-env` creates it on the VM:
#   __generate__  -> random secret generated on the VM
#   __required__  -> must be filled in by hand before the next deploy
# Other values are non-secret defaults copied as-is.

# --- Runtime -------------------------------------------------------------------
STACK_DOMAIN=blog.vitorx86.dev
ACME_EMAIL=vitor.ecomp@gmail.com
# "internal" = Caddy's local CA (no ACME traffic while DNS still points elsewhere).
# Right AFTER the DNS record points at this VM, switch to the ACME email (Let's Encrypt):
#   sed -i 's/^CADDY_TLS=.*/CADDY_TLS=vitor.ecomp@gmail.com/' .env && docker compose up -d caddy
CADDY_TLS=internal
GHOST_DB_PASSWORD=__generate__
MYSQL_ROOT_PASSWORD=__generate__

# --- Backups (cloud/scripts/backup_stack.py -> restic -> GCS, cross-cloud) -----
RESTIC_REPOSITORY=s3:https://storage.googleapis.com/vitorx86-blog-backups/personal-blog
RESTIC_PASSWORD=__generate__
# HMAC key of blog-backup-writer@personal-project-514501.iam.gserviceaccount.com
AWS_ACCESS_KEY_ID=__required__
AWS_SECRET_ACCESS_KEY=__required__
AWS_DEFAULT_REGION=us-central1
# Optional healthchecks.io-style URL pinged after each successful backup:
# BACKUP_PING_URL=
