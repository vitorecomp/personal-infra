# Template for /opt/stacks/personal-blog/.env (mode 0600 on the VM, never committed; CI writes
# GHOST_IMAGE and STACK_DOMAIN). `deploy_stack.py --init-env` creates it on the VM:
#   __generate__  -> random secret generated on the VM
#   __required__  -> must be filled in by hand or synced before deploy
# Other values are non-secret defaults copied as-is.

# --- Runtime -------------------------------------------------------------------
STACK_DOMAIN=__required__
# Digest-pinned Ghost image built by deploy-blog.yml (ghcr.io/vitorecomp/personal-blog@sha256:...),
# written here on every deploy with --sync-env GHOST_IMAGE,STACK_DOMAIN.
GHOST_IMAGE=__required__
GHOST_DB_PASSWORD=__generate__
MYSQL_ROOT_PASSWORD=__generate__

# --- Backups (cloud/scripts/backup_stack.py -> restic -> GCS bucket) ------------
# e.g. s3:https://storage.googleapis.com/<backup-bucket>/personal-blog
RESTIC_REPOSITORY=__required__
RESTIC_PASSWORD=__generate__
# HMAC key of stack-backup-writer@<gcp-project>.iam.gserviceaccount.com
AWS_ACCESS_KEY_ID=__required__
AWS_SECRET_ACCESS_KEY=__required__
AWS_DEFAULT_REGION=us-central1
# Optional healthchecks.io-style URL pinged after each successful backup:
# BACKUP_PING_URL=
