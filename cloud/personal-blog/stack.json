{
  "name": "personal-blog",
  "domain": "blog.vitorx86.dev",
  "edge_tls_key": "BLOG_TLS",
  "registry": "ghcr.io",
  "health_path": "/ghost/api/admin/site/",
  "required_files": [
    "compose.yml",
    ".env.example",
    "stack.json"
  ],
  "post_deploy": {
    "script": "seed_ghost_admin.py",
    "url_flag": "--blog-url"
  },
  "backup": {
    "db": {
      "engine": "mysql",
      "service": "db",
      "database": "ghost"
    },
    "volumes": [
      "personal-blog_ghost-content"
    ]
  }
}
