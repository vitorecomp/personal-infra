{
  "name": "taiga",
  "domain": "taiga.vitorx86.dev",
  "edge_tls_key": "TAIGA_TLS",
  "health_path": "/api/v1/project-templates",
  "required_files": [
    ".env.example",
    "stack.json"
  ],
  "post_deploy": {
    "script": "seed_taiga_admin.py",
    "url_flag": "--taiga-url"
  },
  "backup": {
    "db": {
      "engine": "postgres",
      "mode": "remote",
      "env_prefix": "TAIGA_DB_",
      "client_image": "postgres:15.19-alpine"
    },
    "volumes": [
      "edge_caddy-data"
    ],
    "gcs": [
      "gs://vitorx86-taiga-media"
    ]
  }
}
