# Non-secret Cloud Run settings for cloud/taiga/deploy-cloudrun.sh (resources come from
# cloud/infra/envs/gcp-taiga). Secrets come from the taiga-prod GitHub environment and Secret Manager.
PROJECT=my-gcp-project
REGION=us-central1
REPO=taiga
SERVICE=taiga
RUN_SA=taiga-run@my-gcp-project.iam.gserviceaccount.com
MEDIA_BUCKET=my-taiga-media
# Free-tier sizing: 1 vCPU / 512 MiB, scale 0..1, CPU only while serving requests.
CPU=1
MEMORY=512Mi
MAX_INSTANCES=1
CONCURRENCY=10
