# Non-secret Cloud Run settings for cloud/taiga/deploy-cloudrun.sh (resources come from
# cloud/infra/envs/gcp-taiga). Secrets come from the VM's /opt/stacks/taiga/.env.
PROJECT=personal-project-514501
REGION=us-central1
REPO=taiga
SERVICE=taiga
RUN_SA=taiga-run@personal-project-514501.iam.gserviceaccount.com
MEDIA_BUCKET=vitorx86-taiga-media
# Free-tier sizing: 1 vCPU / 512 MiB, scale 0..1, CPU only while serving requests.
CPU=1
MEMORY=512Mi
MAX_INSTANCES=1
CONCURRENCY=10
