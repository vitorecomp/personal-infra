# Non-secret Cloud Run sizing & service defaults for cloud/taiga/deploy-cloudrun.sh.
# Project, bucket, service account, and domain come from environment / GitHub Secrets / root `.env`.
REGION="${GCP_REGION:-us-central1}"
REPO="${TAIGA_AR_REPO:-taiga}"
SERVICE="${TAIGA_SERVICE:-taiga}"
# Free-tier sizing: 1 vCPU / 512 MiB, scale 0..1, CPU only while serving requests.
CPU=1
MEMORY=512Mi
MAX_INSTANCES=1
CONCURRENCY=10
