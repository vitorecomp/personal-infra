# Shared shape for every stack: TLS termination + compression + one upstream.
# CADDY_TLS is an email (Let's Encrypt via HTTP-01/TLS-ALPN-01) or "internal"
# (local CA, no ACME traffic) while DNS still points at the old platform.
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

{$STACK_DOMAIN} {
	tls {$CADDY_TLS}
	encode zstd gzip
	reverse_proxy {$UPSTREAM}
}
