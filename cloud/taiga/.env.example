# Template for /opt/stacks/taiga/.env (mode 0600 on the VM, never committed,
# never written by CI). `deploy_stack.py --init-env` creates it on the VM:
#   __generate__  -> random secret generated on the VM
#   __required__  -> must be filled in by hand before the next deploy
# Other values are non-secret defaults copied as-is.

# --- Runtime -------------------------------------------------------------------
STACK_DOMAIN=taiga.vitorx86.dev
# Managed Postgres on Neon (direct endpoint, not the -pooler one: Django migrations need a
# real session). Synced from the taiga-prod GitHub environment by the deploy workflow.
TAIGA_DB_HOST=__required__
TAIGA_DB_PORT=5432
TAIGA_DB_NAME=taiga
TAIGA_DB_USER=__required__
TAIGA_DB_PASSWORD=__required__
TAIGA_DB_SSLMODE=require
# MUST equal the Cloud Run value (sessions, auth tokens, signed attachment URLs):
#   python3 cloud/scripts/migrate_gcp_data.py copy-secrets --stack taiga --host deploy@<ip>
TAIGA_SECRET_KEY=__required__
TAIGA_ADMIN_USER=admin
TAIGA_ADMIN_EMAIL=vitor.ecomp@gmail.com
# The entrypoint resets the admin password to this value on every boot.
TAIGA_ADMIN_PASSWORD=__required__
GUNICORN_WORKERS=1

# --- Backups (cloud/scripts/backup_stack.py -> restic -> GCS bucket) ------------
RESTIC_REPOSITORY=s3:https://storage.googleapis.com/vitorx86-backups/taiga
RESTIC_PASSWORD=__generate__
# HMAC key of stack-backup-writer@personal-project-514501.iam.gserviceaccount.com
AWS_ACCESS_KEY_ID=__required__
AWS_SECRET_ACCESS_KEY=__required__
AWS_DEFAULT_REGION=us-central1
# BACKUP_PING_URL=
