# Template for /opt/stacks/taiga/.env (mode 0600 on the VM, never committed). Taiga itself runs
# on Cloud Run and is deployed from GitHub Actions; the VM only backs it up (Neon dump + media
# bucket -> restic), so this file holds just the backup inputs. `deploy_stack.py --init-env`:
#   __generate__  -> random secret generated on the VM
#   __required__  -> must be filled in by hand before the next deploy

# --- Neon Postgres (direct endpoint), synced from the taiga-prod GitHub environment ----------
TAIGA_DB_HOST=__required__
TAIGA_DB_PORT=5432
TAIGA_DB_NAME=taiga
TAIGA_DB_USER=__required__
TAIGA_DB_PASSWORD=__required__
TAIGA_DB_SSLMODE=require

# --- Backups (cloud/scripts/backup_stack.py -> restic -> GCS bucket) ------------
RESTIC_REPOSITORY=s3:https://storage.googleapis.com/vitorx86-backups/taiga
RESTIC_PASSWORD=__generate__
# HMAC key of stack-backup-writer@personal-project-514501.iam.gserviceaccount.com
AWS_ACCESS_KEY_ID=__required__
AWS_SECRET_ACCESS_KEY=__required__
AWS_DEFAULT_REGION=us-central1
# BACKUP_PING_URL=
