# Local .terraform directories
**/.terraform/*
**/.terraform.d/*

.terraform/*
.terraform.d/*

**/.terraform
**/.terraform.d

.terraform
.terraform.d

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (may contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform plan outputs (may contain sensitive variables)
tfplan
*.tfplan

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraform.lock.hcl

# ...except for the VM roots, where the lock file pins provider checksums for
# reproducible manual applies (documentation/vm-provisioning.md).
!envs/gcp-taiga/.terraform.lock.hcl
!envs/oci-blog/.terraform.lock.hcl
