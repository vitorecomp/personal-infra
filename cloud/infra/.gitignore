# Local .terraform directories
**/.terraform/*
**/.terraform.d/*

.terraform/*
.terraform.d/*

**/.terraform
**/.terraform.d

.terraform
.terraform.d

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (may contain secrets)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraform.lock.hcl
