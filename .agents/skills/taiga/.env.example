# Configuration for the Taiga skill (scripts/taiga_cli.py, workspace/scripts/enroll_taiga_projects.py).
# Copy to .agents/skills/taiga/.env (gitignored) and keep it private: chmod 600 .env
# Precedence: CLI flags > real environment variables > this file > Secret Manager fallback.

TAIGA_URL=https://taiga.vitorx86.dev
TAIGA_ADMIN_USER=admin
# Optional second login id, tried when the username login fails.
TAIGA_ADMIN_EMAIL=
# Admin password. Leave empty to read the taiga-admin-password secret with gcloud instead.
TAIGA_ADMIN_PASSWORD=
# Optional: an existing Taiga auth token instead of the password.
TAIGA_AUTH_TOKEN=

# Secret Manager fallback (used only while TAIGA_ADMIN_PASSWORD and TAIGA_AUTH_TOKEN are empty).
TAIGA_SECRET_PROJECT=personal-project-514501
TAIGA_SECRET_NAME=taiga-admin-password
