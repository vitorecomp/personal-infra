# ==============================================================================
# .env — Private & Personal Configuration for `personal-infra`
# ==============================================================================
# Security & Usage:
#   - Gitignored and restricted to owner-only permissions (`chmod 600 .env`).
#   - Read automatically by local scripts (`taiga_cli.py`, `enroll_taiga_projects.py`,
#     `deploy_stack.py`, `deploy-cloudrun.sh`, `seed_ghost_admin.py`, `seed_taiga_admin.py`,
#     `tf_apply_retry.sh`, and `scan_repo_secrets.py`).
#   - Synced to GitHub Actions **Secrets** (masked as `***` in public CI logs) via:
#       python3 cloud/scripts/sync_github_secrets.py --dry-run
#       python3 cloud/scripts/sync_github_secrets.py
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. GitHub Repository & CLI Authentication
# ------------------------------------------------------------------------------

# Target GitHub repository (`owner/repo`) where `sync_github_secrets.py` uploads Secrets.
GITHUB_REPO=vitorecomp/personal-infra

# Optional GitHub PAT for `workspace/scripts/update_repo_stats.py` and `enroll_taiga_projects.py`
# (leave empty when `gh auth login` is already active).
GITHUB_TOKEN=

# Numeric GitHub repository ID (`gh api repos/<owner>/<repo> -q .id`), used in
# `cloud/infra/envs/gcp-taiga/terraform.tfvars` (`github_repository_id`) to pin WIF trust.
GITHUB_REPOSITORY_ID=000000000


# ------------------------------------------------------------------------------
# 2. Domains & Public URLs (Synced as GitHub Repository Secrets)
# ------------------------------------------------------------------------------

# Apex domain managed in Cloudflare DNS (static sites on Vercel).
ROOT_DOMAIN=example.com

# Public hostname for Taiga, terminated by `cloud/edge/Caddyfile` and proxied to Cloud Run.
TAIGA_DOMAIN=taiga.example.com

# Full HTTPS base URL for Taiga (`taiga_cli.py`, `enroll_taiga_projects.py`, `seed_taiga_admin.py`).
TAIGA_URL=https://taiga.example.com

# Public hostname for the Ghost blog, terminated by `cloud/edge/Caddyfile` -> `blog-ghost:2368`.
BLOG_DOMAIN=blog.example.com

# Full HTTPS base URL for Ghost (`seed_ghost_admin.py`).
BLOG_URL=https://blog.example.com


# ------------------------------------------------------------------------------
# 3. TLS, Admin Accounts & Blog Customization (Synced as GitHub Secrets)
# ------------------------------------------------------------------------------

# Email registered with Let's Encrypt in `cloud/edge` for TLS certificates & expiry alerts.
ACME_EMAIL=admin@example.com

# Default full name used when seeding admin accounts (`docker-entrypoint.sh`, `seed_ghost_admin.py`).
ADMIN_NAME=Admin User

# Initial/verified Taiga superuser username (`deploy-taiga.yml`, `taiga_cli.py`).
TAIGA_ADMIN_USER=admin

# Taiga superuser email (synced to the `taiga-prod` GitHub Environment Secret).
TAIGA_ADMIN_EMAIL=admin@example.com

# Display name for the Ghost Owner account (`seed_ghost_admin.py`).
BLOG_ADMIN_NAME=Admin User

# Ghost Owner login email (synced to the `blog-prod` GitHub Environment Secret).
BLOG_ADMIN_EMAIL=admin@example.com

# Publication title set during initial Ghost setup (`seed_ghost_admin.py`).
BLOG_TITLE=Personal Blog

# Custom Ghost theme directory/slug activated post-deploy and labeled on the GHCR image.
BLOG_THEME_NAME=source


# ------------------------------------------------------------------------------
# 4. GCP Project, Buckets & Cloud Run / WIF (Synced as GitHub Repository Secrets)
# ------------------------------------------------------------------------------

# GCP project ID hosting `personal-host`, Cloud Run `taiga`, Secret Manager, and GCS buckets.
GCP_PROJECT_ID=my-gcp-project

# GCP region for Cloud Run and Artifact Registry (`cloud/taiga/deploy-cloudrun.sh`).
GCP_REGION=us-central1

# Versioned GCS bucket storing Terraform state (`terraform init -backend-config="bucket=$TF_STATE_BUCKET"`).
TF_STATE_BUCKET=my-gcp-project-tfstate

# GCS bucket receiving nightly encrypted `restic` backups (`cloud/scripts/backup_stack.py`).
BACKUP_BUCKET=my-infra-backups

# GCS bucket mounted at `/mnt/taiga-storage` in Cloud Run for Taiga uploads & mirrored into backups.
TAIGA_MEDIA_BUCKET=my-taiga-media

# Runtime service account attached to the `taiga` Cloud Run service.
TAIGA_RUN_SA=taiga-run@my-gcp-project.iam.gserviceaccount.com

# Direct Cloud Run `.run.app` URL that edge Caddy proxies `TAIGA_DOMAIN` to
# (`terraform -chdir=cloud/infra/envs/gcp-taiga output -raw taiga_run_url`).
TAIGA_UPSTREAM=https://taiga-000000000000.us-central1.run.app

# Workload Identity Pool Provider resource name (`terraform output -raw github_wif_provider`).
GCP_WIF_PROVIDER=projects/000000000000/locations/global/workloadIdentityPools/github/providers/personal-infra

# Deployer service account impersonated keyless by `deploy-taiga.yml` (`terraform output -raw github_deployer_email`).
GCP_DEPLOY_SA=github-deployer@my-gcp-project.iam.gserviceaccount.com


# ------------------------------------------------------------------------------
# 5. VM SSH Host Key Pinning (Synced to `taiga-prod` & `blog-prod` Secrets)
# ------------------------------------------------------------------------------

# Output of `ssh-keyscan -t ed25519 <VM_IP>` pinned in `~/.ssh/known_hosts` during SSH deploys.
DEPLOY_KNOWN_HOSTS=

# Optional per-environment `known_hosts` overrides (inherit `DEPLOY_KNOWN_HOSTS` when empty).
TAIGA_DEPLOY_KNOWN_HOSTS=
BLOG_DEPLOY_KNOWN_HOSTS=
